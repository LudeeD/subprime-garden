[Unit]
Description=subprime-garden
After=network.target

[Service]
Type=simple
User=subprime-garden
Group=subprime-garden
# Templates/static load from ./templates and ./static (relative, not
# configurable) at startup, so WorkingDirectory is what makes those
# resolve — run `subprime-garden init /etc/subprime-garden` once to
# scaffold them there alongside garden.toml (see README.md). Editing them
# afterwards only needs `systemctl restart`, not a rebuild.
WorkingDirectory=/etc/subprime-garden
ExecStart=/usr/local/bin/subprime-garden serve --config /etc/subprime-garden/garden.toml
# `init` writes ./data paths into garden.toml, which would land under the
# read-only /etc — point them at the one writable directory instead.
Environment=SUBPRIME_SERVER__DATABASE=/var/lib/subprime-garden/garden.db
Environment=SUBPRIME_SERVER__MEDIA_DIR=/var/lib/subprime-garden/media
# Secrets that shouldn't live in the TOML file (password hash, session
# secret) can go here instead, as SUBPRIME_* env vars — see README.md.
EnvironmentFile=-/etc/subprime-garden/garden.env
Restart=on-failure
RestartSec=2

# The binary only ever needs to write under /var/lib/subprime-garden
# (database, WAL files, media) — everything else is read-only.
StateDirectory=subprime-garden
ReadWritePaths=/var/lib/subprime-garden
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
