# Copy to garden.toml and fill in real values, or skip this file entirely and
# configure via SUBPRIME_* environment variables (see README.md) — both work,
# and env vars always win when both are present.

[site]
title = "subprime garden"
description = "A blog about not much in particular."
base_url = "https://garden.example"
author = "Your Name"
# Taxonomy names posts can be grouped under — each gets a `/<name>` index
# and `/<name>/:slug` term page. Add more (e.g. "series") and assign terms
# per post via frontmatter `[taxonomies]`, keyed by name.
taxonomies = ["tags"]

# Collections are the kinds of content on the site. Every item lives at
# /<slug> (slugs are unique across collections), and every collection gets a
# list page at /<name>. `in_feed` puts its items on the home page and in the
# feeds. `sort` is "<key> [asc|desc]" — published_at (the default, desc),
# title, or one of the collection's fields. Fields are typed: text, int,
# date (YYYY-MM-DD), url, media (an uploaded file) or { choice = [...] }.
[[collections]]
name = "posts"
in_feed = true

[[collections]]
name = "pages"

# [[collections]]
# name = "books"
# sort = "finished desc"
# fields.author = "text"
# fields.rating = "int"
# fields.finished = "date"
# fields.cover = "media"
# fields.shelf = { choice = ["read", "reading", "want-to-read"] }

[server]
bind = "127.0.0.1:8080"
database = "./data/garden.db"
media_dir = "./data/media"
# Only set this to true if you're behind a reverse proxy you control —
# otherwise it's a trivial IP-spoofing vector.
trust_proxy_headers = false

[auth]
# username and both fields below get filled in for you by:
#   subprime-garden init
username = "owner"
password_hash = "$argon2id$v=19$m=19456,t=2,p=1$REPLACE$ME"
session_secret = "replace-with-at-least-32-random-bytes"
session_ttl_days = 30

[analytics]
enabled = true
raw_retention_days = 30
ignore_bots = true

[markdown]
syntax_highlighting = true
smart_punctuation = true
footnotes = true

[media]
max_upload_bytes = 10485760
